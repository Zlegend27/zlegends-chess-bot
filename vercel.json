{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/g/:code",
      "destination": "/api/g?c=:code"
    },
    {
      "source": "/(play|game|puzzles|daily|leaderboard|review|lessons|blind|profile|openings|watch|ranked|rush|tactica|lobby|practice|history|avatar|privacy|terms|accessibility|guides)",
      "destination": "/"
    },
    {
      "source": "/(play|game|puzzles|daily|leaderboard|review|lessons|blind|profile|openings|watch|ranked|rush|tactica|lobby|practice|history|avatar|privacy|terms|accessibility|guides)/",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
        }
      ]
    }
  ]
}
